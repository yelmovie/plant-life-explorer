docs/reviews/shared-design-*.html
docs/reviews/shared-design-*.json
docs/reviews/shared-design-*.txt
docs/reviews/shared-design-transcript-*.md

# 중복 사본(원본은 _source/meshy-input)
_unused/duplicates-*/

# Local verification captures and downloaded curriculum originals
docs/reviews/**/*.png
docs/sources/*.hwp

# Archived unused runtime assets and duplicate delivery leftovers
_unused/
