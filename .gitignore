.agents/
.tmp/
.wrangler/
node_modules/
.env
.env.*
!.env.example
*.log
Thumbs.db
.DS_Store

# Rebuild with npm run build; keep original deliverables locally
dist/
*.zip

# Reference textbooks, supplied artwork, source PNGs and historical backups
_reference/
_source/
assets/**/*.png
!assets/icons/*.png
docs/implementation-backup-*/

